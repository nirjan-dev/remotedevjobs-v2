# Database Connection
# Format: postgres://user:password@host:port/database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/remotedevjobs"

# Server-only credential for POST /api/ingest/* and /api/queue/process.
# Generate with: openssl rand -hex 32. Leave empty to disable worker access.
NUXT_WORKER_TOKEN=""

# Public Site URL (for SEO and Sitemap)
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
